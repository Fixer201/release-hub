generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT    @map("draft")
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("project_status")
}

enum EnvironmentType {
  DEVELOPMENT @map("development")
  STAGING     @map("staging")
  PRODUCTION  @map("production")

  @@map("environment_type")
}

enum EnvironmentStatus {
  UNKNOWN     @map("unknown")
  AVAILABLE   @map("available")
  UNAVAILABLE @map("unavailable")

  @@map("environment_status")
}

enum ApkReleaseStatus {
  UPLOADING  @map("uploading")
  PROCESSING @map("processing")
  READY      @map("ready")
  PUBLISHED  @map("published")
  FAILED     @map("failed")

  @@map("apk_release_status")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  username     String       @unique
  passwordHash String       @map("password_hash")
  email        String       @unique
  sessions     Session[]
  projects     Project[]
  apkReleases  ApkRelease[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ProjectGroup {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  projects    Project[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("project_groups")
}

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  ownerId         String        @map("owner_id") @db.Uuid
  groupId         String?       @map("group_id") @db.Uuid
  name            String
  description     String?
  status          ProjectStatus @default(DRAFT)
  repositoryUrl   String?       @map("repository_url")
  developmentUrl  String?       @map("development_url")
  previewUrl      String?       @map("preview_url")
  productionUrl   String?       @map("production_url")
  previewImageUrl String?       @map("preview_image_url")
  storeLinks      Json          @default("[]") @map("store_links")
  localizations   Json          @default("{}")
  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  group           ProjectGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  environments    Environment[]
  releases        ApkRelease[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([groupId])
  @@index([status])
  @@map("projects")
}

model Environment {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  name      String
  type      EnvironmentType
  url       String?
  status    EnvironmentStatus @default(UNKNOWN)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@unique([projectId, name])
  @@index([projectId])
  @@map("environments")
}

model ApkRelease {
  id           String           @id @default(uuid()) @db.Uuid
  projectId    String           @map("project_id") @db.Uuid
  uploadedById String           @map("uploaded_by_id") @db.Uuid
  version      String
  versionCode  Int?             @map("version_code")
  fileName     String           @map("file_name")
  fileSize     Int              @map("file_size")
  storageKey   String           @unique @map("storage_key")
  sha256       String
  status       ApkReleaseStatus @default(UPLOADING)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime         @default(now()) @map("created_at")
  publishedAt  DateTime?        @map("published_at")

  @@index([projectId, createdAt])
  @@index([uploadedById])
  @@index([status])
  @@map("apk_releases")
}
